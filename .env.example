# Local-development examples only. Copy to .env and use non-production values.
POSTGRES_DB=weblens
POSTGRES_USER=weblens
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

# Crawler sở hữu database PostgreSQL riêng; không dùng credential của Control Plane.
CRAWLER_POSTGRES_DB=weblens_crawler
CRAWLER_POSTGRES_USER=weblens_crawler
CRAWLER_POSTGRES_PASSWORD=replace-with-a-crawler-local-only-password
CRAWLER_POSTGRES_PORT=5433
CRAWLER_POSTGRES_URL=postgres://weblens_crawler:replace-with-a-crawler-local-only-password@localhost:5433/weblens_crawler?sslmode=disable

# ClickHouse local dành cho crawl analytics. Production phải dùng network private,
# TLS, role riêng và credential từ secret manager.
CLICKHOUSE_DB=weblens_crawl_analytics
CLICKHOUSE_USER=weblens_crawler
CLICKHOUSE_PASSWORD=replace-with-a-clickhouse-local-only-password
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
CRAWLER_CLICKHOUSE_ADDR=localhost:19000
CRAWLER_CLICKHOUSE_DATABASE=weblens_crawl_analytics
CRAWLER_CLICKHOUSE_USERNAME=weblens_crawler
CRAWLER_CLICKHOUSE_PASSWORD=replace-with-a-clickhouse-local-only-password

# Spring Boot datasource values. The URL is intentionally explicit so remote
# development databases are never inferred from a website target.
DB_URL=jdbc:postgresql://localhost:5432/weblens
DB_USERNAME=weblens
DB_PASSWORD=replace-with-a-local-only-password

# Generate at least 32 random bytes and Base64-encode them. Never reuse this
# example value in a hosted environment.
WEBLENS_JWT_SECRET=replace-with-a-base64-encoded-256-bit-secret
WEBLENS_COOKIE_SECURE=false
WEBLENS_OPENAPI_ENABLED=true
WEBLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tạo một token ngẫu nhiên tối thiểu 32 byte và dùng cùng giá trị cho hai process.
# Đây là secret service-to-service, không phải JWT của người dùng.
WEBLENS_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
WEBLENS_CRAWLER_COMMAND_URL=http://localhost:8081/internal/v1/commands/scans
WEBLENS_CRAWLER_REPORT_BASE_URL=http://localhost:8081
CRAWLER_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
CRAWLER_CONTROL_EVENTS_URL=http://localhost:8080/internal/v1/events/scans
CRAWLER_HTTP_ADDRESS=:8081
CRAWLER_MIGRATE_ON_START=true
CRAWLER_ENV=development
CRAWLER_ANALYTICS_BACKPRESSURE_AGE=15m

# No LLM provider is selected during bootstrap.
# Future provider credentials belong in .env or a secret manager, never source control.
